{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsOIDCAssumeRole",
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::042729137214:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:Dimi-DV/devops-learning:ref:refs/heads/main",
            "repo:Dimi-DV/devops-learning:ref:refs/heads/week4/day24"
          ]
        }
      }
    }
  ]
}
